{
  "routes": [
    { "src": "^/task-board$", "dest": "/task-board/index.html" },
    { "src": "^/calendar$", "dest": "/calendar/index.html" },
    { "src": "^/shopping$", "dest": "/shopping/index.html" },
    { "src": "^/terminy$", "dest": "/terminy/index.html" },
    { "src": "^/$", "dest": "/index.html" },
    { "handle": "filesystem" }
  ],
  "crons": [
    { "path": "/api/check-deadlines", "schedule": "0 6 * * *" }
  ]
}
